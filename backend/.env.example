# Copy to .env locally; add real values only in local env/hosting dashboards.
APP_ORIGIN=http://localhost:5173
DATABASE_URL=
MAX_REQUEST_BODY_BYTES=6291456
UPSTREAM_TIMEOUT_SECONDS=10
OCR_MAX_IMAGE_BYTES=5000000
OCR_MAX_IMAGE_PIXELS=12000000
OCR_WORKER_COUNT=2
OCR_TIMEOUT_SECONDS=15
NORMALIZATION_TIMEOUT_SECONDS=4
DEMO_ACTIONS_ENABLED=false
DEMO_RECIPIENT_E164=
MAX_CALLS_PER_DAY=3
MAX_REMINDERS_PER_DAY=10

# OCR / text normalization. Gemma uses the official Gemini API; Groq is a fallback.
TESSERACT_CMD=
GEMMA_API_BASE_URL=https://generativelanguage.googleapis.com
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_API_KEY=
GROQ_API_KEY=
GROQ_NORMALIZER_MODEL=

# Meta WhatsApp Business Platform.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_REMINDER_TEMPLATE_NAME=
REMINDER_CRON_SECRET=

# LiveKit/Twilio outbound SIP dispatch.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
AGENT_BACKEND_TOKEN=
